{
  "name": "@kuralle-syrinx/studio",
  "version": "4.6.0",
  "private": false,
  "type": "module",
  "description": "Syrinx Studio — browser voice studio for local development: mic capture, live transcript, and session debugging over the Syrinx WebSocket protocol",
  "keywords": [
    "voice",
    "voice-agent",
    "speech",
    "syrinx",
    "studio",
    "devtools"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kuralle/syrinx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuralle/syrinx.git",
    "directory": "apps/studio"
  },
  "bugs": {
    "url": "https://github.com/kuralle/syrinx/issues"
  },
  "exports": {
    "./dist-path": "./dist-path.js",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "dist-path.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "hosted-test": "tsx scripts/hosted-test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "vite build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@kuralle-syrinx/browser-client": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/react-router": "^1.131.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "wrangler": "^4.34.0",
    "ws": "^8.21.0"
  }
}
