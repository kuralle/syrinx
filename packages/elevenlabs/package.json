{
  "name": "@kuralle-syrinx/elevenlabs",
  "version": "4.6.3",
  "private": false,
  "description": "ElevenLabs adapters for Syrinx \u2014 multi-context WebSocket TTS and Scribe v2 Realtime STT",
  "keywords": [
    "voice",
    "voice-agent",
    "speech",
    "syrinx",
    "elevenlabs",
    "speech-to-text",
    "text-to-speech"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kuralle/syrinx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuralle/syrinx.git",
    "directory": "packages/elevenlabs"
  },
  "bugs": {
    "url": "https://github.com/kuralle/syrinx/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./stt": "./src/stt.ts",
    "./tts": "./src/tts.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@kuralle-syrinx/core": "workspace:*",
    "@kuralle-syrinx/stt-core": "workspace:*",
    "@kuralle-syrinx/tts-core": "workspace:*",
    "@kuralle-syrinx/ws": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6",
    "ws": "^8.21.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./stt": {
        "types": "./dist/stt.d.ts",
        "default": "./dist/stt.js"
      },
      "./tts": {
        "types": "./dist/tts.d.ts",
        "default": "./dist/tts.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
