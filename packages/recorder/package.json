{
  "name": "@kuralle-syrinx/recorder",
  "version": "4.6.0",
  "private": false,
  "description": "Stereo call recorder plugin for Syrinx \u2014 time-aligned user/assistant conversation WAV plus per-speaker stems",
  "keywords": [
    "voice",
    "voice-agent",
    "speech",
    "syrinx",
    "recording",
    "wav"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kuralle/syrinx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuralle/syrinx.git",
    "directory": "packages/recorder"
  },
  "bugs": {
    "url": "https://github.com/kuralle/syrinx/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./wav": "./src/wav.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@kuralle-syrinx/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./wav": {
        "types": "./dist/wav.d.ts",
        "default": "./dist/wav.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
