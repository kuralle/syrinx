  },
  "dependencies": {
    "@kuralle-syrinx/core": "workspace:*",
    "@evan/opus": "1.0.3"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
