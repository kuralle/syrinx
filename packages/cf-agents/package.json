{
  "name": "@kuralle-syrinx/cf-agents",
  "version": "4.6.1",
  "private": false,
  "description": "withVoice(Agent) \u2014 add a Syrinx realtime or cascaded voice pipeline to a Cloudflare agents SDK Agent",
  "keywords": [
    "kuralle",
    "syrinx",
    "voice",
    "cloudflare",
    "agents",
    "durable-objects",
    "realtime",
    "cascaded",
    "stt",
    "tts"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kuralle/syrinx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuralle/syrinx.git",
    "directory": "packages/cf-agents"
  },
  "bugs": {
    "url": "https://github.com/kuralle/syrinx/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./r2-recorder": "./src/r2-recorder.ts",
    "./s3-store": "./src/s3-store.ts",
    "./object-store": "./src/object-store.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@kuralle-syrinx/core": "workspace:*",
    "@kuralle-syrinx/realtime": "workspace:*",
    "@kuralle-syrinx/aisdk": "workspace:*",
    "@kuralle-syrinx/kuralle": "workspace:*",
    "@kuralle-syrinx/server-websocket": "workspace:*",
    "@kuralle-syrinx/recorder": "workspace:*",
    "@kuralle-syrinx/ws": "workspace:*",
    "aws4fetch": "^1.0.20"
  },
  "peerDependencies": {
    "agents": ">=0.14.0 <1.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "@types/node": "^22.0.0",
    "agents": "0.14.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./r2-recorder": {
        "types": "./dist/r2-recorder.d.ts",
        "default": "./dist/r2-recorder.js"
      },
      "./s3-store": {
        "types": "./dist/s3-store.d.ts",
        "default": "./dist/s3-store.js"
      },
      "./object-store": {
        "types": "./dist/object-store.d.ts",
        "default": "./dist/object-store.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
