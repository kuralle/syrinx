{
  "name": "@kuralle-syrinx/ws",
  "version": "4.5.1",
  "private": false,
  "description": "Reconnecting WebSocket connection manager for Syrinx provider sockets \u2014 verify-before-trust reconnects, ordered replay, keepalive; Node and Workers",
  "keywords": [
    "voice",
    "voice-agent",
    "speech",
    "syrinx",
    "websocket",
    "reconnect"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kuralle/syrinx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuralle/syrinx.git",
    "directory": "packages/ws"
  },
  "bugs": {
    "url": "https://github.com/kuralle/syrinx/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./realtime": "./src/realtime-socket.ts",
    "./web": "./src/web-socket.ts",
    "./workers": "./src/workers.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@kuralle-syrinx/core": "workspace:*",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "./realtime": {
        "types": "./dist/realtime-socket.d.ts",
        "default": "./dist/realtime-socket.js"
      },
      "./web": {
        "types": "./dist/web-socket.d.ts",
        "default": "./dist/web-socket.js"
      },
      "./workers": {
        "types": "./dist/workers.d.ts",
        "default": "./dist/workers.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
