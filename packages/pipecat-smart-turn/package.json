{
  "name": "@kuralle-syrinx/pipecat-smart-turn",
  "version": "4.6.0",
  "private": false,
  "description": "Pipecat Smart Turn v3 semantic endpointing for Syrinx \u2014 local ONNX end-of-turn analysis",
  "keywords": [
    "voice",
    "voice-agent",
    "speech",
    "syrinx",
    "pipecat",
    "turn-taking",
    "endpointing",
    "onnx"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kuralle/syrinx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuralle/syrinx.git",
    "directory": "packages/pipecat-smart-turn"
  },
  "bugs": {
    "url": "https://github.com/kuralle/syrinx/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./eos": "./src/eos-plugin.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@kuralle-syrinx/core": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "onnxruntime-node": "1.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./eos": {
        "types": "./dist/eos-plugin.d.ts",
        "default": "./dist/eos-plugin.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
