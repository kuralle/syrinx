{
  "name": "@kuralle-syrinx/server-workers-mastra",
  "version": "4.5.0",
  "private": false,
  "description": "Cloudflare Workers voice host template wiring Syrinx to a Mastra reasoner",
  "keywords": [
    "voice",
    "voice-agent",
    "speech",
    "syrinx",
    "cloudflare-workers",
    "mastra"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kuralle/syrinx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuralle/syrinx.git",
    "directory": "packages/server-workers-mastra"
  },
  "bugs": {
    "url": "https://github.com/kuralle/syrinx/issues"
  },
  "type": "module",
  "main": "./src/worker.ts",
  "types": "./src/worker.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:edge": "SYRINX_MASTRA_EDGE_TEST=1 vitest run",
    "wrangler:dry-run": "wrangler deploy --dry-run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.67",
    "@kuralle-syrinx/core": "workspace:*",
    "@kuralle-syrinx/aisdk": "workspace:*",
    "@kuralle-syrinx/mastra": "workspace:*",
    "@mastra/cloudflare": "^1.4.1",
    "@mastra/core": "^1.41.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "@types/node": "^22.0.0",
    "miniflare": "^4.20260601.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6",
    "wrangler": "^4.19.0"
  },
  "publishConfig": {
    "main": "./dist/worker.js",
    "types": "./dist/worker.d.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
