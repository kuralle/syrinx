{
  "name": "@kuralle-syrinx/server-websocket",
  "version": "4.6.2",
  "private": false,
  "description": "Node WebSocket voice host for Syrinx \u2014 browser transport plus Twilio/Telnyx/SmartPBX telephony adapters, background audio, admission control",
  "keywords": [
    "voice",
    "voice-agent",
    "speech",
    "syrinx",
    "telephony",
    "twilio",
    "telnyx"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kuralle/syrinx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuralle/syrinx.git",
    "directory": "packages/server-websocket"
  },
  "bugs": {
    "url": "https://github.com/kuralle/syrinx/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./edge": "./src/edge.ts",
    "./edge-twilio": "./src/edge-twilio.ts",
    "./edge-telnyx": "./src/edge-telnyx.ts",
    "./session-store": "./src/session-store.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@kuralle-syrinx/core": "workspace:*",
    "@kuralle-syrinx/ws": "workspace:*",
    "@evan/opus": "1.0.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./edge": {
        "types": "./dist/edge.d.ts",
        "default": "./dist/edge.js"
      },
      "./edge-twilio": {
        "types": "./dist/edge-twilio.d.ts",
        "default": "./dist/edge-twilio.js"
      },
      "./edge-telnyx": {
        "types": "./dist/edge-telnyx.d.ts",
        "default": "./dist/edge-telnyx.js"
      },
      "./session-store": {
        "types": "./dist/session-store.d.ts",
        "default": "./dist/session-store.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
