{
  "name": "@kuralle-syrinx/vap",
  "version": "4.6.2",
  "private": false,
  "description": "Voice Activity Projection interaction policy for Syrinx \u2014 ONNX turn-taking for Node and Workers",
  "keywords": [
    "voice",
    "voice-agent",
    "speech",
    "syrinx",
    "vap",
    "turn-taking",
    "onnx"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kuralle/syrinx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuralle/syrinx.git",
    "directory": "packages/vap"
  },
  "bugs": {
    "url": "https://github.com/kuralle/syrinx/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./workers": "./src/workers.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@kuralle-syrinx/core": "workspace:*",
    "onnxruntime-node": "1.24.3",
    "onnxruntime-web": "1.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./workers": {
        "types": "./dist/workers.d.ts",
        "default": "./dist/workers.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
